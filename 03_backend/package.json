{
  "name": "tendita-landy-backend",
  "private": true,
  "version": "0.1.0-sandbox",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run src",
    "pretest:integration": "cross-env DATABASE_URL=file:./prisma-test.db npx prisma db push --schema=../02_database/prisma/schema.prisma --skip-generate --accept-data-loss",
    "test:integration": "cross-env DATABASE_URL=file:./prisma-test.db ENVIRONMENT=SANDBOX vitest run tests/integration --testTimeout=20000"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "prisma": "^5.19.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
